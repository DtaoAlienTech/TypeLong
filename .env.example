# Copy this file to ".env" and fill in your key. NEVER commit ".env" or paste the key in chat/screenshots.
# The key stays on the server: the browser never sees it.
DEEPSEEK_API_KEY=

# Optional settings (defaults shown)
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_THINKING=disabled      # recommended: tested with the real DeepSeek API, replies about 3x faster
# AI_DAILY_CAP=400                # max AI calls per day across all players (protects your credits)
# PORT=3001

# Fresh paragraph for every race (the AI writes them in the background; without the AI they are built from word banks)
# PARA_POOL_LOW=30                # refill when fewer than this many unused AI paragraphs are left (per difficulty)
# PARA_POOL_SIZE=60               # ...and stop at this many
# PARA_REFILL_DAILY_CALLS=150     # AI calls per day for refilling (each call = 8 paragraphs). 0 = never use the AI for this
# PARA_POOL=off                   # off = no background refill at all

# Accounts / rankings
# MAX_SIGNUPS_PER_HOUR=100        # new accounts per visitor address per hour
# TRUST_PROXY=1                   # set when hosted behind a proxy (Render, Fly, Cloudflare) so limits use the real visitor address
# DB_PATH=data/typeclash.db       # where player data is stored

# Docker / hosting
# HOST_PORT=3001                  # the port you open in the browser (container always uses 3001 inside)
# DOMAIN=play.example.com         # only for:  docker compose --profile https up -d   (also set TRUST_PROXY=1)
# MAX_CONNECTIONS=5000            # most players connected at once
# MAX_CONN_PER_IP=100             # most connections from one address (a school Wi-Fi shares one address)
# BACKUP_EVERY_HOURS=24           # database backups into data/backups (0 = off)
# BACKUP_KEEP=7                   # how many backups to keep

# MAX_ONLINE=400                  # most players using Quick Match / Private Room at once; extra visitors can still play vs Bot / Solo

# Public server settings
# AI_PER_IP=60                    # AI requests per 10 minutes from one address (everyone behind one router shares it)
# AI_REQUIRE_LOGIN=1              # 1 = only signed-in players may use the AI features
# BIND_ADDR=127.0.0.1             # with HTTPS: keep the plain port 3001 private (only Caddy can reach it)

# Behind a reverse proxy that already exists on your server (see PLAN.md, section 15)
# TRUST_PROXY_HEADER=x-real-ip    # a header your proxy OVERWRITES with the visitor's address (x-real-ip: nginx / Nginx Proxy Manager / Traefik; cf-connecting-ip: Cloudflare)
# PROXY_NETWORK=proxy             # the Docker network your proxy uses, for docker-compose.proxy.yml
